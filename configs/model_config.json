        "random_state": 42
      },
      "scaling_required": true,
      "explainer_type": "LinearExplainer"
    },
    "XGBoost": {
      "class": "xgboost.XGBClassifier",
      "params": {
        "n_estimators": 100,
        "max_depth": 6,
