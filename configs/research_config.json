{
  "project_name": "CardioAI Research Framework",
  "version": "2.0.0",
  "dataset": {
    "raw_path": "data/raw/heart_disease.csv",
    "clean_path": "data/processed/heart_disease_clean.csv",
    "large_clean_path": "data/processed/large_clean.csv",
    "train_path": "data/processed/large_train.csv",
    "test_path": "data/processed/large_test.csv",
    "synthetic_path": "data/processed/large_synthetic_ctgan.csv",
    "target_column": "cardio",
    "test_size": 0.2,
    "stratify": true
  },
  "experiment": {
    "random_seed": 42,
    "repeated_seeds": [42, 52, 62, 72, 82],
    "augmentation_ratios": [0, 25, 50, 75, 100, 125, 150, 175, 200],
    "models": ["logistic_regression", "random_forest", "svm", "xgboost"],
    "primary_metric": "recall",
    "alpha": 0.05
  },
  "ctgan": {
    "epochs": 300,
    "batch_size": 500,
    "generator_dim": [256, 256],
    "discriminator_dim": [256, 256],
    "generator_lr": 0.0002,
    "discriminator_lr": 0.0002,
    "pac": 10
  },
  "bootstrap": {
    "iterations": 1000,
    "confidence_level": 0.95,
    "seed": 42
  },
  "calibration": {
    "n_bins": 10,
    "strategy": "uniform"
  },
  "thresholds": {
    "min_threshold": 0.10,
    "max_threshold": 0.90,
    "step": 0.05
  },
  "paths": {
    "results_dir": "results",
    "validation_dir": "results/validation",
    "synthetic_dir": "results/synthetic",
    "privacy_dir": "results/privacy",
    "augmentation_dir": "results/augmentation",
    "statistics_dir": "results/statistics",
    "robustness_dir": "results/robustness",
    "calibration_dir": "results/calibration",
    "explainability_dir": "results/explainability",
    "experiments_dir": "results/experiments",
    "reports_dir": "results/reports"
  }
}
