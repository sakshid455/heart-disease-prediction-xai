# HeartAI Backend Environment Configuration Template

# Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Origins (CORS)
FRONTEND_URL=http://localhost:3000

# Research Artifact Directories (Defaults to relative paths)
MODEL_PATH=models/optimal_model.joblib
DATA_DIR=data/processed
RESULTS_DIR=results

# ==========================================
# AI Provider Configuration for CardioAI Chatbot
# ==========================================
# Set your AI API key here (OpenAI, OpenRouter, Groq, Gemini, or compatible provider)
AI_API_KEY=put your api key here
# Target model (e.g., gpt-4o-mini, gpt-4o, claude-3-5-sonnet, gemini-1.5-pro, deepseek-chat)
AI_MODEL=gpt-4o-mini
# Optional base URL if using an alternate OpenAI-compatible provider (e.g., https://openrouter.ai/api/v1)
# AI_BASE_URL=https://api.openai.com/v1
